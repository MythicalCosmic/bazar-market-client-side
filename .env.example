VITE_API_BASE_URL=https://api.bazarmarket.org/api
VITE_APP_NAME=Bazar Market
VITE_DEFAULT_LOCALE=uzx
VITE_DEFAULT_LAT=40.4569
VITE_DEFAULT_LNG=72.3144
# Yandex "JavaScript API" key — used to display the map. Add bazarmarket.org,
# api.bazarmarket.org and localhost to the key's HTTP-Referer allowlist.
VITE_YANDEX_API_KEY=
# Yandex "Geocoder API" key — a SEPARATE service/key used for address lookup
# (reverse geocoding) via the HTTP Geocoder. Without it the map shows but
# addresses won't resolve. Grab it from the "Keys" tab next to the Geocoder API.
VITE_YANDEX_GEOCODER_KEY=